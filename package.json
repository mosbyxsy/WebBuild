{
  "name": "@mosbydev/web-build",
  "version": "1.0.0",
  "description": "Dependency-aware builders for browser extensions and static sites.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "extb": "./lib/extb/cli.js",
    "ssb": "./lib/ssb/cli.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./extb": {
      "types": "./lib/extb/index.d.ts",
      "import": "./lib/extb/index.js"
    },
    "./ssb": {
      "types": "./lib/ssb/index.d.ts",
      "import": "./lib/ssb/index.js"
    }
  },
  "homepage": "https://github.com/mosbyxsy/web-build#readme",
  "bugs": {
    "url": "https://github.com/mosbyxsy/web-build/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mosbyxsy/web-build.git"
  },
  "author": {
    "name": "mosbyxsy",
    "url": "https://github.com/mosbyxsy"
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "node tests/run.mjs",
    "clean": "rimraf lib",
    "prepack": "npm run clean && npm test"
  },
  "dependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "acorn": "^8.15.0",
    "acorn-walk": "^8.3.4",
    "archiver": "^7.0.1",
    "clean-css": "^5.3.3",
    "commander": "^14.0.0",
    "html-minifier-terser": "^7.2.0",
    "htmlparser2": "^10.0.0",
    "jiti": "^2.5.1",
    "minimatch": "^10.0.3",
    "terser": "^5.44.0"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/babel__core": "^7.20.5",
    "@types/babel__preset-env": "^7.10.0",
    "@types/clean-css": "^4.2.11",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/node": "^24.3.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.2",
    "yauzl": "^3.2.0"
  },
  "keywords": [
    "web-build",
    "browser-extension",
    "extb",
    "ssb",
    "static-site",
    "chrome-extension",
    "firefox-addon",
    "webextension",
    "minify",
    "packager"
  ]
}
